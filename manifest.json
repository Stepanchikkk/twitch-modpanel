{
  "manifest_version": 3,
  "name": "Twitch ModPanel",
  "version": "1.2.0",
  "description": "Панель модератора для Twitch — быстрый и удобный доступ к инструментам модерации и управления трансляцией.",
  "permissions": [
    "storage",
    "tabs",
    "cookies"
  ],
  "host_permissions": [
    "https://api.twitch.tv/*",
    "https://id.twitch.tv/*",
    "https://*.twitch.tv/*"
  ],
  "web_accessible_resources": [
    {
      "resources": ["twitch-api.js", "icons/icon128.png", "icons/icon-*.svg"],
      "matches": ["https://*.twitch.tv/*"]
    }
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://*.twitch.tv/*"],
      "js": ["preload.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://*.twitch.tv/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "type": "module"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Twitch ModPanel"
  }
}
